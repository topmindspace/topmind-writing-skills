{
  "name": "@topmindspace/topmind-writing-skills",
  "version": "0.8.21",
  "description": "TopMindSpace 写作技能合集 — 通过 npm / npx 安装技能（公众号长文、X 长文/短文、封面图）。",
  "license": "MIT",
  "author": "TopMindspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topmindspace/topmind-writing-skills.git"
  },
  "homepage": "https://github.com/topmindspace/topmind-writing-skills#readme",
  "bugs": {
    "url": "https://github.com/topmindspace/topmind-writing-skills/issues"
  },
  "keywords": [
    "agent-skills",
    "ai-skills",
    "writing",
    "wechat",
    "x-twitter",
    "briefs",
    "cover"
  ],
  "type": "commonjs",
  "bin": {
    "topmind-writing-skills": "bin/topmind-writing-skills.js"
  },
  "files": [
    "bin",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "topmind-briefs",
    "topmind-cover",
    "topmind-poster",
    "topmind-viral-posts",
    "topmind-wechat-post",
    "topmind-x-article"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "list": "node bin/topmind-writing-skills.js list",
    "discover": "node scripts/discover_skills.js",
    "sync:files": "node scripts/sync_npm_files.js",
    "prepack": "node scripts/sync_npm_files.js",
    "install:skills": "node -e \"const {discoverSkills}=require('./scripts/discover_skills'); const {spawnSync}=require('child_process'); for (const id of discoverSkills()) { const r=spawnSync(process.execPath,['bin/topmind-writing-skills.js','install',id],{stdio:'inherit'}); if(r.status) process.exit(r.status||1); }\"",
    "check": "node scripts/run_skill_gates.js check",
    "privacy": "python3 scripts/ci_privacy_scan.py",
    "audit": "node scripts/run_skill_gates.js audit",
    "package:skill": "node scripts/run_skill_gates.js package"
  },
  "publishConfig": {
    "access": "public"
  }
}
